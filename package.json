{
  "name": "teste-rezidentiat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/config.mjs && ng serve --host 127.0.0.1",
    "build": "node scripts/config.mjs && ng build",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "audit:questions": "node --import tsx scripts/audit-question-quality.ts",
    "audit:questions:release": "node --import tsx scripts/audit-question-quality.ts --release"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "@supabase/supabase-js": "2.116.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
